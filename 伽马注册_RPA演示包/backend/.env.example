# 复制为 backend/.env 后填写真实值（.env 已 gitignore，勿提交）。
# 生产 ECS 与本机调试共用此模板。

# ---------- 运行模式 ----------
# 生产 / 公网：1（无头 Chrome）。本机要看填报窗口：0
GAMMA_HEADLESS=1
# 公网禁止 A 页监控
GAMMA_ALLOW_MONITOR=0
# 并行填报软上限（路）；满载或内存不足时入等待队列，不互杀
GAMMA_MAX_CONCURRENT_FILLS=4
# 可用物理内存低于此值（MB）时同样进入等待队列
GAMMA_MIN_FREE_MB=1200

# ---------- 鉴权 ----------
# 管理页 /api/admin/* 公网访问必需（长随机串）
GAMMA_ADMIN_TOKEN=请换成足够长的随机串
# 建议固定，避免每次重启 bootstrap token 体系漂移
GAMMA_BOOTSTRAP_SECRET=请换成32位以上随机十六进制
# 可选：共享写接口口令（与页面 bootstrap token 二选一即可）
# GAMMA_API_TOKEN=

# ---------- 阿里云短信 ----------
# 暂时关闭注册页短信验证（1=关闭，0=开启）
GAMMA_SMS_AUTH_DISABLED=1
GAMMA_SMS_ACCESS_KEY_ID=
GAMMA_SMS_ACCESS_KEY_SECRET=
GAMMA_SMS_SIGN_NAME=上海玛布山科技
GAMMA_SMS_TEMPLATE_CODE=SMS_247335065
# GAMMA_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com
# GAMMA_SMS_REGION_ID=cn-hangzhou
# GAMMA_SMS_TIMEOUT=10
